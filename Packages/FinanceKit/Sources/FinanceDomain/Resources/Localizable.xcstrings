          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngân sách tự chọn ngày cần có ngày kết thúc."
          }
        }
      }
    },
    "A recurring transaction uses this category. Change or delete it first, or archive the category." : {
      "localizations" : {
