    "Amounts in %@ cannot be combined with amounts in %@ without an explicit exchange rate." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amounts in %@ cannot be combined with amounts in %@ without an explicit exchange rate."
