  "strings" : {
    "A budget is limited to this wallet. Change that budget first, or archive the wallet." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A budget is limited to this wallet. Change that budget first, or archive the wallet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この口座に限定された予算があります。先にその予算を変更するか、口座をアーカイブしてください。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có ngân sách chỉ áp dụng cho ví này. Hãy sửa ngân sách đó trước, hoặc lưu trữ ví."
          }
        }
      }
    },
    "A custom budget needs an end date." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
