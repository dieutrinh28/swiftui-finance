        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể đổi loại tiền khi mục tiêu đã có tiền để dành."
          }
        }
      }
    },
    "The currency can't change once the wallet has transactions." : {
      "localizations" : {
