    },
    "This records how much of your money is set aside for the goal. It does not move money between wallets or change any balance; record a transfer for that." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This records how much of your money is set aside for the goal. It does not move money between wallets or change any balance; record a transfer for that."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標のために取り分けた金額を記録します。口座間でお金を移動したり残高を変更したりはしません。移動するには振替を記録してください。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mục này ghi lại số tiền bạn để dành cho mục tiêu. Nó không chuyển tiền giữa các ví hay thay đổi số dư; hãy ghi một giao dịch chuyển tiền nếu cần."
          }
        }
