    "The app never runs in the background and never records a transaction by itself. Due items wait until you open the app and confirm them." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app never runs in the background and never records a transaction by itself. Due items wait until you open the app and confirm them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリはバックグラウンドで動作せず、取引を自動で記録することもありません。予定日の項目は、アプリを開いて確認するまで待機します。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng không chạy nền và không bao giờ tự ghi giao dịch. Các khoản đến hạn chờ đến khi bạn mở ứng dụng và xác nhận."
          }
        }
      }
    },
    "The currency can't change once money has been set aside for this goal." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The currency can't change once money has been set aside for this goal."
