  "strings" : {
    "%@ budget is %lld%% used" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ budget is %lld%% used"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予算「%1$@」の %2$lld%% を使用しました"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngân sách %1$@ đã dùng %2$lld%%"
          }
        }
      }
    },
    "%@ budget is used up" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ budget is used up"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予算「%@」を使い切りました"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngân sách %@ đã dùng hết"
          }
        }
      }
    },
    "%@ is archived, so it is no longer offered. Choose another wallet; until then nothing becomes due." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is archived, so it is no longer offered. Choose another wallet; until then nothing becomes due."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はアーカイブ済みのため、選択肢に表示されません。別の口座を選んでください。選ぶまで期日は来ません。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã được lưu trữ nên không còn trong danh sách chọn. Hãy chọn ví khác; trước khi chọn, khoản này không đến hạn."
          }
        }
      }
    },
    "%@ is archived, so it is no longer offered. Saving removes it from this goal unless you choose another wallet." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is archived, so it is no longer offered. Saving removes it from this goal unless you choose another wallet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はアーカイブ済みのため、選択肢に表示されません。別の口座を選ばずに保存すると、この目標との関連付けが解除されます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã được lưu trữ nên không còn trong danh sách chọn. Khi lưu, mục tiêu sẽ bỏ liên kết với ví này, trừ khi bạn chọn ví khác."
          }
        }
      }
    },
    "%@ is archived, so nothing becomes due. Restore the category or choose another one." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is archived, so nothing becomes due. Restore the category or choose another one."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はアーカイブされているため、期日は来ません。カテゴリを元に戻すか、別のカテゴリを選んでください。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã được lưu trữ nên không có khoản nào đến hạn. Hãy khôi phục danh mục hoặc chọn danh mục khác."
          }
        }
      }
    },
    "%@ is archived, so nothing becomes due. Restore the wallet or choose another one." : {
