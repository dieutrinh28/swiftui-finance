    "Replaces all data on this iPhone with the backup. The file is checked first, and a copy of your current data is kept in Files › On My iPhone › Finance › %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replaces all data on this iPhone with the backup. The file is checked first, and a copy of your current data is kept in Files › On My iPhone › Finance › %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この iPhone のすべてのデータをバックアップの内容に置き換えます。ファイルは事前に検証され、現在のデータのコピーが「ファイル › このiPhone内 › Finance › %@」に保存されます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay toàn bộ dữ liệu trên iPhone này bằng bản sao lưu. Tệp được kiểm tra trước, và một bản sao dữ liệu hiện tại được giữ trong Tệp › Trên iPhone › Finance › %@."
          }
        }
      }
    },
    "Reports" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reports"
          }
