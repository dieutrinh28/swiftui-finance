    "Transfers are not income or expenses. Archived wallets are included. Opening balances count from the start." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transfers are not income or expenses. Archived wallets are included. Opening balances count from the start."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "振替は収入・支出に含みません。アーカイブ済みの口座も含みます。初期残高は最初から計上されます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển tiền không phải thu hay chi. Có tính các ví đã lưu trữ. Số dư ban đầu được tính từ đầu."
          }
        }
      }
    },
    "Transfers are not income or expenses. Irregular expenses are not counted as spending; Net includes them." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transfers are not income or expenses. Irregular expenses are not counted as spending; Net includes them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "振替は収入にも支出にもなりません。臨時支出は支出に含まれませんが、純額には含まれます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển tiền không phải thu nhập hay chi tiêu. Chi tiêu bất thường không tính là chi tiêu; Ròng có tính chúng."
          }
        }
      }
    },
    "Transfers between your own wallets are not counted as income or expenses." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transfers between your own wallets are not counted as income or expenses."
