    "%lld matching expenses use another currency and are not counted. The app never converts currencies on its own." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld matching expense uses another currency and is not counted. The app never converts currencies on its own."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld matching expenses use another currency and are not counted. The app never converts currencies on its own."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対象の支出のうち %lld 件は別の通貨のため集計されていません。アプリが自動で通貨を換算することはありません。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld khoản chi phù hợp dùng loại tiền khác nên không được tính. Ứng dụng không bao giờ tự quy đổi tiền tệ."
          }
        }
      }
    },
    "%lld new wallet(s) were created without an opening balance. Set it in each wallet if needed." : {
