    "Set aside about this much each month for %lld month(s) to reach it on time." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Set aside about this much each month for %lld month to reach it on time."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Set aside about this much each month for %lld months to reach it on time."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期限までに達成するには、%lld か月間、毎月この金額ほど積み立ててください。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để dành khoảng chừng này mỗi tháng trong %lld tháng để đạt đúng hạn."
          }
        }
      }
    },
    "Set aside per month" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set aside per month"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎月の積立額"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để dành mỗi tháng"
          }
        }
      }
    },
    "Set money aside for an emergency fund, a trip or a new laptop and track your progress. Goals never change your wallet balances." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set money aside for an emergency fund, a trip or a new laptop and track your progress. Goals never change your wallet balances."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生活防衛資金、旅行、新しいノートパソコンなどのためにお金を取り分け、進捗を確認しましょう。目標が口座の残高を変えることはありません。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để dành tiền cho quỹ dự phòng, chuyến du lịch hay chiếc laptop mới và theo dõi tiến độ. Mục tiêu không bao giờ thay đổi số dư ví."
          }
        }
      }
    },
