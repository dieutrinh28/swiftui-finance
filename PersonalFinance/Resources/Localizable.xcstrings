    "1 %@ = %@ %@. The app never converts currencies on its own." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 %@ = %@ %@. The app never converts currencies on its own."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 %1$@ = %2$@ %3$@。アプリが自動で通貨を換算することはありません。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 %1$@ = %2$@ %3$@. Ứng dụng không bao giờ tự quy đổi tiền tệ."
          }
        }
      }
    },
    "A balance below zero is money you owe. It is never counted as available cash." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A balance below zero is money you owe. It is never counted as available cash."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイナスの残高は借りているお金です。使えるお金には含まれません。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số dư âm là tiền bạn đang nợ. Không bao giờ được tính là tiền có sẵn."
          }
        }
      }
    },
    "A budget plans your spending for one or more categories over a week, a month, a year or custom dates, and shows how much is left." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A budget plans your spending for one or more categories over a week, a month, a year or custom dates, and shows how much is left."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予算では、1 つ以上のカテゴリの支出を週・月・年または指定期間ごとに計画し、残りの金額を確認できます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngân sách giúp lên kế hoạch chi tiêu cho một hoặc nhiều danh mục theo tuần, tháng, năm hoặc khoảng ngày tự chọn, và cho biết còn bao nhiêu."
          }
        }
      }
    },
    "A complete copy of your wallets, transactions, categories, budgets, savings goals and recurring transactions. Save it outside this iPhone, for example in iCloud Drive or on a computer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A complete copy of your wallets, transactions, categories, budgets, savings goals and recurring transactions. Save it outside this iPhone, for example in iCloud Drive or on a computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "口座、取引、カテゴリ、予算、貯金目標、定期取引をすべて含むコピーです。iCloud Drive やコンピュータなど、この iPhone の外に保存してください。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản sao đầy đủ ví, giao dịch, danh mục, ngân sách, mục tiêu tiết kiệm và giao dịch định kỳ. Hãy lưu ở ngoài iPhone này, ví dụ trên iCloud Drive hoặc máy tính."
          }
        }
      }
    },
    "A notification on the due day. iOS decides when it is delivered; the transaction is only recorded when you confirm it in the app." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A notification on the due day. iOS decides when it is delivered; the transaction is only recorded when you confirm it in the app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予定日に通知します。通知のタイミングは iOS が決め、取引はアプリで確認したときにのみ記録されます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một thông báo vào ngày đến hạn. iOS quyết định thời điểm gửi; giao dịch chỉ được ghi khi bạn xác nhận trong ứng dụng."
          }
        }
      }
    },
    "A notification when a budget reaches one of its alert levels (set on each budget, 80 percent and used up by default), once per budget period." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A notification when a budget reaches one of its alert levels (set on each budget, 80 percent and used up by default), once per budget period."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予算が通知レベル（予算ごとに設定、既定は 80 パーセントと使い切り）に達したときに、予算期間ごとに 1 回通知します。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông báo khi ngân sách chạm một mức cảnh báo (đặt riêng cho từng ngân sách, mặc định 80 phần trăm và khi dùng hết), một lần mỗi kỳ ngân sách."
          }
        }
      }
    },
    "A simple, private way to see your money clearly." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A simple, private way to see your money clearly."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お金の流れを、シンプルにプライベートに。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cách đơn giản và riêng tư để nhìn rõ tiền của bạn."
          }
        }
      }
    },
    "A sub-category is counted in its parent's budgets and reports, and shown under it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sub-category is counted in its parent's budgets and reports, and shown under it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブカテゴリは親カテゴリの予算とレポートに含まれ、その下に表示されます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danh mục con được tính vào ngân sách và báo cáo của danh mục cha, và hiển thị bên dưới nó."
          }
        }
      }
    },
    "A transfer moves money between your own wallets. It is not income or an expense." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A transfer moves money between your own wallets. It is not income or an expense."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "振替は自分の口座間でお金を移動するもので、収入や支出ではありません。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển tiền là di chuyển tiền giữa các ví của bạn. Không phải thu hay chi."
          }
        }
      }
    },
