        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển tiền giữa các ví của bạn không được tính là thu hay chi."
          }
        }
      }
    },
    "Transfers move money between your wallets. They are not counted as income, expenses or budget spending." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transfers move money between your wallets. They are not counted as income, expenses or budget spending."
